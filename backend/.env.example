# Copy to .env and fill in real values. NEVER commit .env.
# The application refuses to start, in ANY environment, without a strong
# SECRET_KEY (SR-STORE-09, DD-05).

# --- Application ---
APP_ENV=development                 # development | production
APP_NAME="Smart Home Security API"
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required. At least 32 characters. Leave empty here; set it only in .env.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Brute-force protection (SR-AUTH-11/13, DD-05) ---
# All login attempts per client IP:
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=300
# Failed logins per (client IP, email). Accounts are never locked globally.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# Token refreshes per client IP:
REFRESH_IP_LIMIT=60
REFRESH_IP_WINDOW_SECONDS=300

# --- Database ---
DATABASE_PATH=./data/smarthome.db
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Household timezone (used by permission windows from Day 4) ---
HOUSEHOLD_TIMEZONE=UTC

# --- CORS: comma-separated scheme://host[:port]; "*" is rejected (SR-STORE-19) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI tier kill switch (DD-08 decision 7) ---
# Off by default. Only the exact word "true" enables, and only when the gate
# record lists every required check as passed (app/ai/core/config.py).
AI_ENABLED=false
GEMINI_ENABLED=false
# Path to the JSON gate record. Leave empty until V2-V5 and the live checks
# have been run and recorded.
AI_GATE_RECORD=
# GEMINI_API_KEY is deliberately absent: the Gemini adapter does not exist yet.
