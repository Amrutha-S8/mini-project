# Copy to .env and fill in real values. NEVER commit .env.
# The application refuses to start, in ANY environment, without a strong
# SECRET_KEY (SR-STORE-09, DD-05).

# --- Application ---
APP_ENV=development                 # development | production
APP_NAME="Smart Home Security API"
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required. At least 32 characters. Leave empty here; set it only in .env.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Brute-force protection (SR-AUTH-11/13, DD-05) ---
# All login attempts per client IP:
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=300
# Failed logins per (client IP, email). Accounts are never locked globally.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# Token refreshes per client IP:
REFRESH_IP_LIMIT=60
REFRESH_IP_WINDOW_SECONDS=300

# --- Database ---
DATABASE_PATH=./data/smarthome.db
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Household timezone (used by permission windows from Day 4) ---
HOUSEHOLD_TIMEZONE=UTC

# --- CORS: comma-separated scheme://host[:port]; "*" is rejected (SR-STORE-19) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Suspicious activity monitoring (M13) ---
# Findings at or above this severity notify the homeowner (low never does).
NOTIFY_MIN_SEVERITY=medium
# Informational rule: registered-member access inside these local hours.
MONITORING_QUIET_HOURS=01:00-05:00
INCIDENT_MERGE_WINDOW_MINUTES=30
NOTIFICATION_COOLDOWN_MINUTES=15

# --- Homeowner notifications (M20) ---
# Values go in .env only. Leave a channel disabled until every field is set;
# the app then records "not_configured" and never pretends to send.
# WhatsApp Cloud API (Meta). Outside the 24-hour window Meta delivers only an
# approved template; it must have 4 body variables:
# {{1}} severity, {{2}} title, {{3}} reason, {{4}} incident id and time.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Used to verify delivery-status webhooks (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# E.164 format, e.g. +919876543210
HOMEOWNER_WHATSAPP_NUMBER=
# SMS fallback through Twilio.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Defaults to HOMEOWNER_WHATSAPP_NUMBER when empty.
HOMEOWNER_SMS_NUMBER=
# Optional public https URL of /api/v1/notifications/webhooks/twilio.
# Without it, use POST /api/v1/notifications/{id}/refresh to read the status.
TWILIO_STATUS_CALLBACK_URL=
NOTIFICATION_TIMEOUT_SECONDS=10

# --- AI tier kill switch (DD-08 decision 7) ---
# Off by default. Only the exact word "true" enables, and only when the gate
# record lists every required check as passed (app/ai/core/config.py).
AI_ENABLED=false
GEMINI_ENABLED=false
# Path to the JSON gate record. Leave empty until V2-V5 and the live checks
# have been run and recorded.
AI_GATE_RECORD=
# GEMINI_API_KEY is deliberately absent: the Gemini adapter does not exist yet.
